APP_NAME="FlowTrack Supplier Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://suppliers.example.com
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flowtrack_supplier_portal
DB_USERNAME=flowtrack_supplier_portal
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=__Host-flowtrack_supplier_session
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=60
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=supplier-portal@example.com
MAIL_FROM_NAME="FlowTrack Supplier Portal"
SUPPLIER_FILE_SCAN_COMMAND=clamscan

# One-way signed API receiver for FlowTracker; use a distinct shared secret.
FLOWTRACK_BRIDGE_ENABLED=false
FLOWTRACK_SUPPLIER_BRIDGE_SECRET=
